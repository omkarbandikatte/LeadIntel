digraph LeadIntelArchitecture {
    graph [splines=true, bgcolor=white, fontname="Helvetica"];
    node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=11, fixedsize=true, width=2.0, height=0.75];
    edge [fontname="Helvetica", fontsize=9, color="#555555", arrowsize=0.7];

    node [fillcolor="#fff4e0", color="#c98a1c"];

    // Row 0 (top) - y=520
    BEAT  [label="Celery Beat\n(scheduler / cron)", pos="0,520!"];
    REDIS [label="Redis\n(broker + backend)", shape=hexagon, fillcolor="#eeeeee", color="#666666", pos="250,520!"];
    FIRMO [label="Firmographic Scraper\nPlaywright/bs4", pos="500,520!"];
    JOBS  [label="Job Posting Scraper\nPlaywright/bs4", pos="750,520!"];

    // Row 1 - y=360
    NEWS [label="News / Press Scraper\nfeedparser + RSS", pos="0,360!"];
    RAW  [label="Raw Document Store\nPostgres JSONB", shape=cylinder, fillcolor="#e3edf7", color="#3b6ea5", pos="250,360!"];
    NLP  [label="NLP Service\nspaCy + local HF model", pos="500,360!"];
    FEAT [label="Feature Store\nfirmo + NLP + CRM", shape=cylinder, fillcolor="#e3edf7", color="#3b6ea5", pos="750,360!"];

    // Row 2 - y=200
    SCORE [label="Scoring Service\nrules -> sklearn/XGBoost", pos="0,200!"];
    CORE  [label="Core Tables\ncompanies, leads, scores", shape=cylinder, fillcolor="#e3edf7", color="#3b6ea5", pos="250,200!"];
    API   [label="Backend API (FastAPI)\n/leads /scores /crm-sync", pos="500,200!"];
    WEB   [label="Dashboard\nNext.js + React", pos="750,200!"];

    // Row 3 (bottom) - y=40
    CRM [label="CRM Sync Service\nCSV / DB export-import", pos="500,40!"];
    EXT [label="Existing CRM /\nSpreadsheet", shape=parallelogram, fillcolor="#f5f5f5", color="#888888", pos="750,40!"];

    BEAT -> REDIS;
    REDIS -> FIRMO;
    REDIS -> JOBS;
    REDIS -> NEWS;
    FIRMO -> RAW;
    JOBS -> RAW;
    NEWS -> RAW;
    RAW -> NLP;
    NLP -> FEAT;
    FEAT -> SCORE;
    SCORE -> CORE;
    CORE -> API;
    API -> WEB;
    API -> CRM [dir=both];
    CRM -> EXT [style=dashed, label="CSV"];
}
